# Local backend only. Put the real key in .env or Render environment settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=30000
AI_SESSION_LIMIT=6
AI_GLOBAL_PER_MINUTE=30
AI_GLOBAL_PER_DAY=500
# Exact Vercel origin, no trailing slash. Multiple origins may be comma-separated.
FRONTEND_ORIGIN=
# Default true locally; set false on Render when Vercel serves the frontend.
SERVE_FRONTEND=true
# Vercel build setting only: https://your-service.onrender.com (no /api).
# BACKEND_URL is public. Never put your Gemini key in this value.
